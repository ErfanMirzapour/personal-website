---
import { siGithub, siInstagram, siTelegram } from 'simple-icons';
import { site } from '../data/site';
// simple-icons no longer ships LinkedIn, so it and the envelope are drawn here.
const links = [
  { name: 'LinkedIn', href: site.linkedin, icon: 'linkedin' },
  { name: 'GitHub', href: site.github, path: siGithub.path },
  { name: 'Telegram', href: site.telegram, path: siTelegram.path },
  { name: 'Instagram', href: site.instagram, path: siInstagram.path },
  { name: 'Email', href: `mailto:${site.email}`, icon: 'mail' },
];
---

<ul class="icons">
  {links.map((link) => (
    <li>
      <a href={link.href} aria-label={link.name} title={link.name}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          {link.path && <path d={link.path} />}
          {link.icon === 'linkedin' && (
            <>
              <rect x="1.5" y="1.5" width="21" height="21" rx="3.5" />
              <g class="cut">
                <circle cx="7.3" cy="7.2" r="1.55" />
                <rect x="5.95" y="9.6" width="2.7" height="8.6" rx="0.3" />
                <path d="M10.6 9.6h2.6v1.2c.55-.85 1.55-1.45 2.95-1.45 2.2 0 3.35 1.4 3.35 4v4.85h-2.7v-4.45c0-1.3-.45-2.05-1.55-2.05-1.15 0-1.95.8-1.95 2.2v4.3h-2.7z" />
              </g>
            </>
          )}
          {link.icon === 'mail' && (
            <>
              <rect x="1.5" y="4" width="21" height="16" rx="3" />
              <path
                class="cut-line"
                d="M4.5 7.5l7.5 5.6 7.5-5.6"
                fill="none"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </>
          )}
        </svg>
      </a>
    </li>
  ))}
</ul>

<style>
  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line, rgb(148 170 200 / 0.2));
    border-radius: 50%;
    color: var(--text, #e6ecf5);
    background: rgb(22 33 49 / 0.6);
    transition:
      color 0.2s,
      border-color 0.2s,
      translate 0.2s,
      box-shadow 0.2s;
  }
  a:hover {
    color: var(--ion, #7cc4ff);
    border-color: var(--ion, #7cc4ff);
    translate: 0 -3px;
    box-shadow: 0 0 24px rgb(124 196 255 / 0.35);
  }
  a:focus-visible {
    outline: 2px solid var(--photon, #f5c97a);
    outline-offset: 3px;
  }
  svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .cut {
    fill: var(--void, #0c111a);
  }
  .cut-line {
    stroke: var(--void, #0c111a);
  }
</style>
