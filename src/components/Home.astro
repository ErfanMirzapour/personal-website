---
import { site, skills, strengths, experience, interests } from '../data/site';
import { type Design } from '../data/designs';
import { getPublishedPosts, formatDate } from '../lib/posts';
interface Props {
  design: Design;
  base?: string;
  preview?: boolean;
}
const { design, base = '', preview = false } = Astro.props;
const posts = await getPublishedPosts();
---

<main id="main">
  {design === 'notebook' && (
    <aside class="notebook-index" aria-label="On this page">
      <span class="index-label">~/erfan</span>
      <a href="#about">01 / about</a>
      <a href="#expertise">02 / toolkit</a>
      <a href="#experience">03 / experience</a>
      <a href="#beyond">04 / off-screen</a>
      <a href={`${base}/blog/`}>05 / writing</a>
      <span class="index-foot">
        Tehran, Iran
        <br />
        Available for full-time work
      </span>
    </aside>
  )}
  <div class="home-content">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-top">
        <span class="eyebrow">
          {design === 'notebook'
            ? '// frontend engineer'
            : 'Senior Frontend Engineer'}
        </span>
        <span class="location">Tehran, Iran</span>
      </div>
      <div class="hero-heading">
        {design === 'editorial' && (
          <h1 id="intro-title">
            Thoughtful interfaces.
            <br />
            <em>Built with care.</em>
          </h1>
        )}
        {design === 'swiss' && (
          <h1 id="intro-title">
            ERFAN
            <br />
            MIRZAPOUR<span class="accent">.</span>
          </h1>
        )}
        {design === 'notebook' && (
          <h1 id="intro-title">
            Hello, I’m Erfan<span class="accent">_</span>
            <br />
            <span class="hero-secondary">I build for the web.</span>
          </h1>
        )}
        {design === 'dark' && (
          <h1 id="intro-title">
            Good engineering.
            <br />
            <span class="hero-secondary">Thoughtful experiences.</span>
          </h1>
        )}
        {design === 'journal' && (
          <h1 id="intro-title">
            A little about me,
            <br />
            <em>and the things I build.</em>
          </h1>
        )}
      </div>
      <div class="hero-bottom">
        <div>
          <p class="intro">
            {design !== 'swiss' && <span>I’m Erfan Mirzapour. </span>}
            {site.intro}
          </p>
          <a class="text-link hero-link" href={`mailto:${site.email}`}>
            Get in touch <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="availability">
          <span class="availability-line">Open to work</span>
          <p>
            Looking for my next <br />
            full-time frontend role.
          </p>
        </div>
      </div>
      {design === 'swiss' && (
        <div class="swiss-caption">
          <span>SELECTED EXPERIENCE / 2019—2026</span>
          <a href="#experience">Explore my work ↓</a>
        </div>
      )}
      {design === 'journal' && (
        <p class="journal-note">Engineer by profession. Curious by nature.</p>
      )}
    </section>
    <section id="about" class="content-section about-section">
      <div class="section-label">
        <span>01</span>
        <h2>A little context</h2>
      </div>
      <div class="section-body">
        <p class="large-copy">
          Good interfaces start with understanding the people who use them.
        </p>
        <p>{site.about}</p>
        <div class="strengths">
          {strengths.map((s) => (
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section id="expertise" class="content-section">
      <div class="section-label">
        <span>02</span>
        <h2>My toolkit</h2>
      </div>
      <div class="section-body skills-grid">
        {skills.map((group) => (
          <div class="skill-group">
            <h3>{group.name}</h3>
            <ul>
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
    <section id="experience" class="content-section">
      <div class="section-label">
        <span>03</span>
        <h2>Along the way</h2>
      </div>
      <div class="section-body experience-list">
        {experience.map((job, index) => (
          <article class:list={['job', { 'recent-job': index === 0 }]}>
            <div class="job-heading">
              <div>
                <h3>{job.company}</h3>
                <p class="job-role">{job.role}</p>
              </div>
              <p class="job-date">
                {job.start} — {job.end}
              </p>
            </div>
            <ul>
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            {job.tech && <p class="job-tech">{job.tech}</p>}
          </article>
        ))}
        <p class="education">
          BE, Software Engineering
          <br />
          <strong>K. N. Toosi University of Technology</strong>
        </p>
      </div>
    </section>
    <section id="beyond" class="content-section beyond-section">
      <div class="section-label">
        <span>04</span>
        <h2>Off-screen</h2>
      </div>
      <div class="section-body">
        <p class="large-copy">
          There’s more to life
          <br />
          <em>than a browser window.</em>
        </p>
        <p>Some of the things I enjoy away from work.</p>
        <ul class="interests">
          {interests.map((interest, index) => (
            <li>
              <span class="interest-number" aria-hidden="true">
                0{index + 1}
              </span>
              {interest}
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="content-section writing-section">
      <div class="section-label">
        <span>05</span>
        <h2>Writing</h2>
      </div>
      <div class="section-body">
        <p class="large-copy">
          Notes from the web,
          <br />
          and everything around it.
        </p>
        {posts.length ? (
          <ul class="post-list">
            {posts.slice(0, 3).map((post) => (
              <li>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </li>
            ))}
          </ul>
        ) : (
          <p>
            No articles published yet. This will be a place for my thoughts on
            engineering, technology, and things I’m learning.
          </p>
        )}
        <a class="text-link" href={`${base}/blog/`}>
          Visit the writing page <span aria-hidden="true">↗</span>
        </a>
        {preview && (
          <a class="sample-link" href={`${base}/blog/reading-sample/`}>
            Preview an article layout →
          </a>
        )}
      </div>
    </section>
    <section id="contact" class="contact-section">
      <span class="eyebrow">Have a role in mind?</span>
      <h2>
        Let’s build
        <br />
        <em>something good.</em>
      </h2>
      <a class="contact-email" href={`mailto:${site.email}`}>
        {site.email} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</main>
