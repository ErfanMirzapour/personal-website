---
import Base from '../layouts/Base.astro';
import Orbit from '../components/Orbit.astro';
import { site, profile, contact, career } from '../data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.title,
  email: `mailto:${contact.email}`,
  alumniOf: career.education.school,
  sameAs: [
    contact.linkedin,
    contact.github,
    contact.telegramUrl,
    contact.instagram,
  ],
};
---

<Base title={profile.seoTitle} schema={schema}>
  <Orbit />
</Base>
