---
import Base from '../layouts/Base.astro';
import Orbit from '../components/Orbit.astro';
import { site, education } from '../data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.title,
  email: `mailto:${site.email}`,
  alumniOf: education.school,
  sameAs: [site.linkedin, site.github, site.telegram, site.instagram],
};
---

<Base title="Erfan Mirzapour — Senior Frontend Engineer" schema={schema}>
  <Orbit />
</Base>
